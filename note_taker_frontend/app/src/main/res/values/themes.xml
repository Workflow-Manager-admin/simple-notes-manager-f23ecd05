<resources>
    <!-- AppTheme with light, modern style and provided palette -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">#222222</item>
        <item name="android:textColorSecondary">#555555</item>
        <item name="android:windowBackground">@color/secondary</item>
        <item name="android:background">@color/secondary</item>
        <item name="android:editTextBackground">@color/secondary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/secondary</item>
    </style>
    <style name="ModernDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:background">@color/secondary</item>
    </style>
</resources>
